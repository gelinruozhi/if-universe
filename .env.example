# ===== 如果宇宙 环境变量模板 =====
# 复制为 .env 后按需修改：cp .env.example .env

# 服务端口（默认3000）
PORT=3000
HOST=0.0.0.0

# ===== AI 提供商（二选一）=====
# 火山引擎 ARK：Key 以 ark- 开头，MODEL 为接入点ID（ep- 开头）
ARK_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=ep-xxxxxxxxxxxxx-xxxxx

# 阿里云百炼 DashScope：Key 以 sk- 开头
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# DASHSCOPE_MODEL=qwen-plus

# ===== 管理员 =====
YUZHOU_ADMIN=admin
YUZHOU_ADMIN_PASS=change-me-please

# 运行环境
NODE_ENV=production
